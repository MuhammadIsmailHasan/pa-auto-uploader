FLASK_ENV=production
SECRET_KEY=GANTI_DENGAN_HASIL_OPENSSL_RAND_HEX_32
DATABASE_URL=mysql+pymysql://perkara_user:PASSWORD_DB_BARU@127.0.0.1/perkara_pdf_manager?charset=utf8mb4

# Pertahankan path ini agar record database lama tetap menunjuk file yang benar.
IMPORT_SOURCE_DIR=/srv/perkara_pdf_manager/dokumen_perkara
STORAGE_DIR=/srv/perkara_pdf_manager/processed
PREVIEW_DIR=/srv/perkara_pdf_manager/previews
EXPORT_DIR=/srv/perkara_pdf_manager/hasil_identifikasi
UPLOADED_DIR=/srv/perkara_pdf_manager/uploaded
LOG_DIR=/home/panitera/perkara_pdf_manager/logs

# Sumber template eksternal yang dipakai instalasi lama.
REGISTRATION_TEMPLATE_DIR="/mnt/server_data_new_kepaniteraan/99. LAIN LAIN/PROYEK"
REGISTRATION_SIGNATURE_DIR=/home/panitera/e_kepaniteraan_integration_stage/assets/tte/bas

OCR_DPI=200
OCR_LANG=ind
MAX_OCR_PAGES=3
RENAME_APPLY=false
MAX_UPLOAD_MB=20480
MAX_FORM_MEMORY_MB=64
MAX_FORM_PARTS=20000

SELENIUM_BROWSER=chrome
SELENIUM_HEADLESS=false
SELENIUM_HUMAN_DELAY=true
SELENIUM_KEEP_BROWSER_OPEN=false
TARGET_LOGIN_URL=
TARGET_USERNAME=
TARGET_PASSWORD=
TARGET_SELECTORS_FILE=/home/panitera/perkara_pdf_manager/config/selenium_selectors.example.json

# Gunakan akun SIPP yang hanya mempunyai hak SELECT/read-only.
SIPP_RO_HOST=192.168.1.7
SIPP_RO_PORT=3306
SIPP_RO_DATABASE=sipp
SIPP_RO_USER=GANTI_USER_READ_ONLY
SIPP_RO_PASSWORD=GANTI_PASSWORD_READ_ONLY

# Integrasi BAS opsional; sesuaikan jika endpoint berada di server lain.
WICAKSANA_BAS_API=http://127.0.0.1/wicaksana/api/bas_ready.php

