[Unit]
Description=Auto PDF Uploader Gunicorn
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
User=panitera
Group=panitera
WorkingDirectory=/home/panitera/perkara_pdf_manager
Environment="PATH=/home/panitera/perkara_pdf_manager/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/panitera/perkara_pdf_manager/.venv/bin/gunicorn --workers 2 --timeout 600 --bind 0.0.0.0:8000 wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
